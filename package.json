{
  "name": "suzicam",
  "version": "0.1.0-test",
  "description": "수지캠 (SuziCam) - PC 화면 녹화기 및 웹 테스트",
  "main": "main.js",
  "homepage": "https://kookppong.github.io/cam-lite/",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.suzicam.recorder",
    "productName": "SuziCam",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "수지캠 (SuziCam)"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
